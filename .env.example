# Every variable here is optional — ClawStash boots with no .env at all, and the
# two uncommented lines below only restate the built-in defaults. TRUST_PROXY is
# the one conditional: required once the app sits behind a reverse proxy.
#
# Docker Compose note: a copy of this file at `.env` is read for `${...}`
# interpolation inside docker-compose.yml, NOT injected into the container. A
# variable only reaches the app if the service lists it under `environment:` or
# sets `env_file: .env` — see docs/deployment.md → Docker Compose.
#
# Server port (optional, default: 3000)
PORT=3000
# Bind address of the production server (optional, default: 0.0.0.0).
# The Next.js standalone server.js listens on `process.env.HOSTNAME || '0.0.0.0'`.
# Mostly a Docker concern: the daemon sets HOSTNAME to the container id, which
# would bind only the container-IP interface (in-container loopback, healthcheck
# and sidecar access break) — the Dockerfile therefore overrides it back to
# 0.0.0.0. Set it explicitly to bind one interface, e.g. 127.0.0.1 to expose the
# app only to a reverse proxy on the same host.
# HOSTNAME=0.0.0.0
# Database path (optional, default: ./data/clawstash.db)
DATABASE_PATH=./data/clawstash.db
# Node.js / Next.js environment mode (optional, default: development for `npm run dev`, production for `npm run build && npm start`).
# Set to "production" when running the built output outside of Docker (Next.js auto-sets this for most commands).
# NODE_ENV=production
# Admin password for login (optional, if unset all admin features are open)
# ADMIN_PASSWORD=your-secret-password
# Admin session duration in hours (optional, default: 24, 0 = no expiration).
# Format: a number (decimals allowed, e.g. 0.5 for 30 minutes). Anything that is
# not a finite number >= 0 (typo, negative value, "abc") silently falls back to
# the safe 24h default instead of creating a never-expiring session.
# ADMIN_SESSION_HOURS=24
# Trust X-Forwarded-* headers from a reverse proxy (default: off; conditionally
# required — see below).
# Format: exactly "1" or "true" — the check is an exact string compare, so any
# other truthy-looking value (yes, on, TRUE, enabled) leaves the option OFF.
# REQUIRED when behind nginx, Traefik, Cloudflare, etc. — otherwise
# rate limiting falls back to per-request random keys (no shared bucket,
# but no protection either) and OpenAPI / MCP spec URLs use the host
# header verbatim. Also gates HSTS: behind a TLS-terminating proxy
# (x-forwarded-proto: https) a Strict-Transport-Security header is sent;
# plain-HTTP/LAN deployments never receive it.
# TRUST_PROXY=1
# Version-history retention: how many snapshots of ONE stash are kept in
# stash_versions (optional, default: 200).
# Format: a non-negative integer. 0 = unlimited, pruning is fully disabled.
# Anything else that is not a non-negative integer (negative, fractional,
# "abc") silently falls back to 200 rather than to an accidentally tiny cap.
#
# THIS DELETES DATA. Pruning is deliberately narrow: it runs only while a NEW
# version of that one stash is being written (an update or a restore), inside
# the same transaction, and touches no other stash. There is no start-up sweep
# and no migration that deletes rows, so upgrading alone never removes
# anything — a stash only ever loses its oldest snapshots on its next update,
# and only once it holds more than this many. Every prune is logged as
# "[DB] Pruned N version snapshot(s) of stash <id> (STASH_VERSION_LIMIT=N)".
# Set STASH_VERSION_LIMIT=0 to keep today's unbounded behaviour.
# STASH_VERSION_LIMIT=200
# Timeout in milliseconds for the web UI's own API requests (optional,
# default: 10000). Read at BUILD time, not at runtime: NEXT_PUBLIC_* values are
# inlined into the client bundle, so changing this needs a rebuild of the image
# (see docs/deployment.md → Environment Variables).
# Format: a non-negative integer. 0 = no timeout (wait forever, the pre-#535
# behaviour). Anything else falls back to 10000. Full data export/import and
# every call that reaches the GitHub API get 6x this budget.
# NEXT_PUBLIC_CLAWSTASH_FETCH_TIMEOUT_MS=10000
# Encryption key for secrets stored at rest (GitHub backup token).
# 64 hex characters (32 bytes), e.g. from: openssl rand -hex 32
# Optional: when unset, a key file is auto-generated next to the database
# (data/.clawstash-key, mode 0600) — keep it with your data volume.
# CLAWSTASH_ENCRYPTION_KEY=

# --- Build-time env vars (CI/Docker only) -----------------------------
# Override the git information embedded into build-info.json. Set by the
# GitHub Actions workflow so the running container reports the commit
# that produced it, even though the image has no .git directory.
# Both optional: unset falls back to the working tree's git information
# (`git rev-parse --short HEAD` / `git rev-parse --abbrev-ref HEAD`).
# Format: full commit sha / plain branch name, e.g. from github.sha and
# github.ref_name in .github/workflows/docker-publish.yml.
# BUILD_COMMIT_SHA=<commit sha>
# BUILD_BRANCH=<branch name>
