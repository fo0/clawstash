node_modules/
dist/
.next/
next-env.d.ts
data/
*.db
*.sqlite
.env
# Next.js also loads `.env.local`, `.env.production`, `.env.*.local`. Only the
# bare `.env` was ignored, so any of those would have been offered by `git add`
# — `.dockerignore` already guards `.env.*`, this keeps the two in step. The
# negation keeps the committed template tracked.
.env.*
!.env.example
.DS_Store
*.log
*.pem
*.key
# AES-256-GCM key auto-generated by src/server/backup/backup-crypto.ts next to
# the SQLite database. It lands inside the ignored `data/` directory only while
# DATABASE_PATH keeps its default; any other path (e.g. `./clawstash.db`) drops
# the secret into the working tree, and `*.key` above does not match it.
.clawstash-key
.vscode/
.idea/
*.tsbuildinfo
build-info.json
.gitnexus/
